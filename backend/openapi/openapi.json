  "components": {
    "schemas": {
      "CalendarWorkoutExerciseSchema": {
        "properties": {
          "name": { "type": "string", "title": "Name" },
          "status": { "type": "string", "title": "Status" },
          "setCount": { "type": "integer", "title": "Setcount" },
          "result": { "type": "string", "title": "Result" }
        },
        "type": "object",
        "required": ["name", "status", "setCount", "result"],
        "title": "CalendarWorkoutExerciseSchema"
      },
      "CalendarWorkoutSchema": {
        "properties": {
          "id": { "type": "integer", "title": "Id" },
          "title": { "type": "string", "title": "Title" },
          "status": { "type": "string", "enum": ["completed", "partial", "aborted"], "title": "Status" },
          "startedAt": { "type": "string", "format": "date-time", "title": "Startedat" },
          "finishedAt": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }], "title": "Finishedat" },
          "timeLabel": { "type": "string", "title": "Timelabel" },
          "duration": { "type": "string", "title": "Duration" },
          "exerciseCount": { "type": "integer", "title": "Exercisecount" },
          "setCount": { "type": "integer", "title": "Setcount" },
          "volume": { "type": "string", "title": "Volume" },
          "exercises": { "items": { "$ref": "#/components/schemas/CalendarWorkoutExerciseSchema" }, "type": "array", "title": "Exercises" }
        },
        "type": "object",
        "required": ["id", "title", "status", "startedAt", "finishedAt", "timeLabel", "duration", "exerciseCount", "setCount", "volume", "exercises"],
        "title": "CalendarWorkoutSchema"
      },
      "CalendarDaySchema": {
        "properties": {
          "id": { "type": "string", "title": "Id", "description": "ISO date YYYY-MM-DD" },
          "day": { "type": "integer", "title": "Day" },
          "inMonth": { "type": "boolean", "title": "Inmonth" },
          "isToday": { "type": "boolean", "title": "Istoday" },
          "workouts": { "items": { "$ref": "#/components/schemas/CalendarWorkoutSchema" }, "type": "array", "title": "Workouts" }
        },
        "type": "object",
        "required": ["id", "day", "inMonth", "isToday", "workouts"],
        "title": "CalendarDaySchema"
      },
      "WorkoutCalendarDataSchema": {
        "properties": {
          "month": { "type": "string", "title": "Month", "description": "YYYY-MM" },
          "title": { "type": "string", "title": "Title" },
          "today": { "type": "string", "title": "Today", "description": "ISO date of the server-local current day" },
          "weekdays": { "items": { "type": "string" }, "type": "array", "title": "Weekdays" },
          "days": { "items": { "$ref": "#/components/schemas/CalendarDaySchema" }, "type": "array", "title": "Days", "description": "Always 42 days, Monday first" },
          "workoutCount": { "type": "integer", "title": "Workoutcount" }
        },
        "type": "object",
        "required": ["month", "title", "today", "weekdays", "days", "workoutCount"],
        "title": "WorkoutCalendarDataSchema"
      },
      "AccessRole": {
        "type": "string",
        "enum": [
          "member",
          "coach",
          "admin",
          "service"
        ],
        "title": "AccessRole"
      },
      "CommonDirectoriesSchema": {
        "properties": {
          "roles": {
            "items": {
              "$ref": "#/components/schemas/DirectoryItemSchema"
            },
            "type": "array",
            "title": "Roles"
          },
          "accents": {
            "items": {
              "$ref": "#/components/schemas/DirectoryItemSchema"
            },
            "type": "array",
            "title": "Accents"
          },
          "machineStates": {
            "items": {
              "$ref": "#/components/schemas/DirectoryItemSchema"
            },
            "type": "array",
            "title": "Machinestates"
          },
          "driveStates": {
            "items": {
              "$ref": "#/components/schemas/DirectoryItemSchema"
            },
            "type": "array",
            "title": "Drivestates"
          },
          "safetyStates": {
            "items": {
              "$ref": "#/components/schemas/DirectoryItemSchema"
            },
            "type": "array",
            "title": "Safetystates"
          }
        },
        "type": "object",
        "required": [
          "roles",
          "accents",
          "machineStates",
          "driveStates",
          "safetyStates"
        ],
        "title": "CommonDirectoriesSchema"
      },
      "CurrentUserSchema": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "$ref": "#/components/schemas/AccessRole"
          },
          "readinessPercent": {
            "type": "integer",
            "title": "Readinesspercent"
          },
          "accent": {
            "$ref": "#/components/schemas/UserAccent"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserProfileSchema"
              },
              {
                "type": "null"
              }
            ]
          },
          "goals": {
            "items": {
              "$ref": "#/components/schemas/UserGoalSchema"
            },
            "type": "array",
            "title": "Goals"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "readinessPercent",
          "accent",
          "profile",
          "goals"
        ],
        "title": "CurrentUserSchema"
      },
      "DashboardAlertSchema": {
        "properties": {
          "tone": {
            "$ref": "#/components/schemas/NotificationTone"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "tone",
          "title",
          "description"
        ],
        "title": "DashboardAlertSchema"
      },
      "DashboardBuilderWorkoutExerciseSchema": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "idle"
          },
          "completedSets": {
            "type": "integer",
            "title": "Completedsets",
            "default": 0
          },
          "targetSets": {
            "type": "integer",
            "title": "Targetsets",
            "default": 0
          },
          "progressPercent": {
            "type": "integer",
            "title": "Progresspercent",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name"
        ],
        "title": "DashboardBuilderWorkoutExerciseSchema"
      },
      "DashboardBuilderWorkoutSchema": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "exercises": {
            "items": {
              "$ref": "#/components/schemas/DashboardBuilderWorkoutExerciseSchema"
            },
            "type": "array",
            "title": "Exercises"
          },
          "duration": {
            "type": "string",
            "title": "Duration"
          },
          "lastPerformedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lastperformedat"
          },
          "lastStatus": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "completed",
                  "partial",
                  "aborted"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Laststatus"
          },
          "todayStatus": {
            "type": "string",
            "title": "Todaystatus",
            "default": "idle"
          },
          "todayProgressPercent": {
            "type": "integer",
            "title": "Todayprogresspercent",
            "default": 0
          },
          "todayCompletedExercises": {
            "type": "integer",
            "title": "Todaycompletedexercises",
            "default": 0
          },
          "todayTotalExercises": {
            "type": "integer",
            "title": "Todaytotalexercises",
            "default": 0
          },
          "resumeAvailable": {
            "type": "boolean",
            "title": "Resumeavailable",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "exercises",
          "duration"
        ],
        "title": "DashboardBuilderWorkoutSchema"
      },
      "DashboardDataSchema": {
        "properties": {
          "greeting": {
            "type": "string",
            "title": "Greeting"
          },
          "recommendationTitle": {
            "type": "string",
            "title": "Recommendationtitle"
          },
          "recommendationText": {
            "type": "string",
            "title": "Recommendationtext"
          },
          "readinessPercent": {
            "type": "integer",
            "title": "Readinesspercent"
          },
          "todayWorkout": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DashboardWorkoutSchema"
              },
              {
                "type": "null"
              }
            ]
          },
          "workouts": {
            "items": {
              "$ref": "#/components/schemas/DashboardBuilderWorkoutSchema"
            },
            "type": "array",
            "title": "Workouts"
          },
          "machine": {
            "$ref": "#/components/schemas/MachineHealthSchema"
          },
          "alerts": {
            "items": {
              "$ref": "#/components/schemas/DashboardAlertSchema"
            },
            "type": "array",
            "title": "Alerts"
          },
          "recommendedExercises": {
            "items": {
              "$ref": "#/components/schemas/DashboardRecommendationSchema"
            },
            "type": "array",
            "title": "Recommendedexercises"
          },
          "quickStart": {
            "items": {
              "$ref": "#/components/schemas/DashboardQuickStartItemSchema"
            },
            "type": "array",
            "title": "Quickstart"
          },
          "progress": {
            "items": {
              "$ref": "#/components/schemas/DashboardProgressMetricSchema"
            },
            "type": "array",
            "title": "Progress"
          },
          "muscles": {
            "items": {
              "$ref": "#/components/schemas/MuscleCardSchema"
            },
            "type": "array",
            "title": "Muscles"
          }
        },
        "type": "object",
        "required": [
          "greeting",
          "recommendationTitle",
          "recommendationText",
          "readinessPercent",
          "todayWorkout",
          "workouts",
          "machine",
          "alerts",
          "recommendedExercises",
          "quickStart",
          "progress",
          "muscles"
        ],
        "title": "DashboardDataSchema"
      },
      "DashboardProgressMetricSchema": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "value": {
            "type": "string",
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "title": "DashboardProgressMetricSchema"
      },
      "DashboardQuickStartItemSchema": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "stats": {
            "type": "string",
            "title": "Stats"
          },
          "last": {
            "type": "string",
            "title": "Last"
          }
        },
        "type": "object",
        "required": [
          "name",
          "stats",
          "last"
        ],
        "title": "DashboardQuickStartItemSchema"
      },
      "DashboardRecommendationSchema": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "muscles": {
            "type": "string",
            "title": "Muscles"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "name",
          "muscles",
          "status"
        ],
        "title": "DashboardRecommendationSchema"
      },
      "DashboardWorkoutSchema": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "exercises": {
            "type": "integer",
            "title": "Exercises"
          },
          "sets": {
            "type": "integer",
            "title": "Sets"
          },
          "duration": {
            "type": "string",
            "title": "Duration"
          },
          "list": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "List"
          }
        },
        "type": "object",
        "required": [
          "title",
          "exercises",
